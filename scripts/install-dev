#!/usr/bin/env bash
set -euo pipefail
repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
plugin_id=io.github.howieduhzit.omaflip
plugin_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/$plugin_id"
if [[ -e "$plugin_dir" ]]; then
  echo "Refusing to overwrite $plugin_dir. Disable and update your existing checkout explicitly." >&2
  exit 1
fi
[[ -x "$HOME/.local/lib/omaflip/omaflip" ]] || { echo 'Run scripts/build first.' >&2; exit 1; }
omarchy plugin validate "$repo_dir"
mkdir -p "$plugin_dir"
for entry in manifest.json BarWidget.qml Panel.qml Service.qml qml scripts service tests proto udev docs screenshots CMakeLists.txt README.md LICENSE CONTRIBUTING.md CHANGELOG.md .gitignore; do
  cp -r -- "$repo_dir/$entry" "$plugin_dir/"
done
omarchy plugin validate "$plugin_dir"
omarchy-shell shell rescanPlugins
# Discovery is asynchronous. Bounded installation retries, no runtime polling.
for attempt in 1 2 3 4 5; do
  if omarchy plugin enable "$plugin_id" --section right; then exit 0; fi
  sleep 1
done
echo 'Plugin copied but enabling failed. Inspect the Omarchy shell log and enable it manually.' >&2
exit 1
