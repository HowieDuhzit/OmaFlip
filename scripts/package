#!/usr/bin/env bash
set -euo pipefail
repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# Defaults to a clean-source release; --allow-dirty is preparation only.
# Builds/tests an isolated source snapshot, never installs or reuses repo/build.
exec python3 "$repo_dir/packaging/release.py" "$@"
